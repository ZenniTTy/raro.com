# Copie para `.env` (gitignored). O app NÃO lê este ficheiro sozinho —
# passe as keys no run/build:
#   flutter run --dart-define=REVENUECAT_API_KEY_IOS=test_... \
#               --dart-define=REVENUECAT_API_KEY_ANDROID=test_...
#
# Enquanto Play/Apple não tiverem produtos Active, use a Test Store key
# NAS DUAS plataformas. A key `goog_` só vale depois dos SKUs Active na Play.
# NUNCA passe uma key `test_` em build release / Play / App Store.

REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=
