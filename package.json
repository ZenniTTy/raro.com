{
  "name": "raro",
  "private": true,
  "version": "0.0.1",
  "description": "Raro Camera — hands-free professional video capture (iOS + Android)",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=20.9"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "lefthook": "^1.10.10",
    "turbo": "^2.3.3"
  }
}
