{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["^typecheck"]
    },
    "analyze": {
      "outputs": []
    },
    "build": {
      "outputs": ["build/**"],
      "dependsOn": ["^typecheck"]
    }
  }
}
