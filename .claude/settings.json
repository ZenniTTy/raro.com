{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run *)",
      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(flutter pub get *)",
      "Bash(dart analyze *)",
      "Bash(dart test *)",
      "Bash(dart format *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(curl *pub.dev*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)",
      "Bash(rm -rf /*)",
      "Bash(* --no-gpg-sign*)"
    ]
  },
  "hooks": {},
  "enabledMcpjsonServers": []
}
