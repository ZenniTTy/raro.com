{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": [
      "**/.dart_tool/**",
      "**/build/**",
      "**/ios/Pods/**",
      "**/android/.gradle/**",
      "**/android/app/build/**",
      "**/*.g.dart",
      "**/*.freezed.dart",
      "**/pubspec.lock",
      "**/bun.lock",
      "**/node_modules/**",
      "**/ios/Runner/Assets.xcassets/**",
      "**/ios/Pods/**",
      "docs/briefing/prototype/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none"
    }
  }
}
